{
  "name": "homecare",
  "version": "3.0.2",
  "scripts": {
    "android": "expo run:android",
    "build:aab": "node --env-file-if-exists=.env scripts/build-aab.mjs",
    "ios": "expo run:ios",
    "start": "expo start",
    "prebuild": "expo prebuild",
    "lint": "eslint \"**/*.{js,jsx,mjs,ts,tsx}\" --max-warnings 0 && prettier -c \"**/*.{js,jsx,mjs,ts,tsx,json,yml,yaml}\"",
    "lint:workflows": "bash scripts/check-workflows.sh",
    "format": "eslint \"**/*.{js,jsx,mjs,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,mjs,ts,tsx,json,yml,yaml}\" --write",
    "expo:doctor": "expo-doctor",
    "config:check": "node --env-file-if-exists=.env scripts/verify-build-config.mjs --mode release",
    "security:check": "node scripts/check-secret-files.mjs",
    "eas-build-pre-install": "if [ \"$EAS_BUILD_PLATFORM\" = android ]; then node scripts/verify-build-config.mjs --mode release; fi",
    "deps:check": "bun src/utils/dependencyCompatibility.ts",
    "deps:inventory": "bun src/utils/dependencyCompatibility.ts --inventory",
    "typecheck": "tsc --noEmit && tsc --project reviewer/tsconfig.json --noEmit",
    "reviewer:dev": "vite --config reviewer/vite.config.ts --host 0.0.0.0",
    "reviewer:build": "vite build --config reviewer/vite.config.ts",
    "reviewer:preview": "vite preview --config reviewer/vite.config.ts --host 0.0.0.0",
    "reviewer:seed": "node scripts/seed-feedback-emulator.mjs",
    "web": "expo start --web",
    "test": "bun scripts/run-unit-tests.mjs",
    "test:rules": "bun test --timeout 30000 src/security",
    "migrate:local": "bun src/migrations/cli.ts",
    "emulators:local": "bunx firebase-tools@15.30.2 emulators:start --project demo-homecare-migration --only auth,firestore --export-on-exit reports/local-emulators",
    "test:ci-helpers": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@noble/ciphers": "^2.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/analytics": "^26.4.0",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/auth": "^26.4.0",
    "@react-native-firebase/crashlytics": "^26.4.0",
    "@react-native-firebase/firestore": "^26.4.0",
    "@react-native-firebase/messaging": "^26.4.0",
    "@react-native-firebase/remote-config": "^26.4.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/drawer": "^7.14.3",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "@tailwindcss/postcss": "4.3.3",
    "autoprefixer": "^10.6.1",
    "baseline-browser-mapping": "^2.11.27",
    "caniuse-lite": "^1.0.30001814",
    "expo": "~54.0.37",
    "expo-application": "~7.0.8",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-localization": "~17.0.9",
    "expo-notifications": "~0.32.17",
    "expo-print": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-store-review": "~9.0.9",
    "expo-system-ui": "~6.0.9",
    "i18next": "^26.4.2",
    "lottie-react-native": "~7.3.6",
    "nativewind": "5.0.0-preview.3",
    "postcss": "^8.5.29",
    "react": "19.1.0",
    "react-i18next": "^17.0.15",
    "react-native": "0.81.5",
    "react-native-css": "~3.0.7",
    "react-native-fbsdk-next": "13.4.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.7",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "0.5.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/react": "~19.1.17",
    "@types/semver": "^7.8.0",
    "babel-preset-expo": "~54.0.12",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "expo-doctor": "^1.20.4",
    "firebase": "12.17.1",
    "globals": "^16.5.0",
    "lightningcss": "1.30.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "semver": "^7.8.5",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.4"
  },
  "main": "node_modules/expo/AppEntry.js",
  "engines": {
    "node": ">=22.13.0",
    "bun": ">=1.4.2"
  },
  "overrides": {
    "@expo/metro-config": {
      "lightningcss": "1.30.1",
      "postcss": "^8.5.29"
    }
  },
  "private": true
}
