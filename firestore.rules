rules_version = '2';

// Access control for HomeCare (LGPD art. 46): each user only reaches their own
// profile and the houses they belong to. Membership is the access record
// user_house_access/{houseId}_{userId}, created with the house or from a
// pending invitation for the user's email.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Email-based grants (invitations, caregiver links) only count for an email the
    // user proved to own: anyone can sign up with an address that isn't theirs
    function isVerifiedEmail(email) {
      return signedIn()
        && request.auth.token.email_verified == true
        && email == request.auth.token.email.lower();
    }

    function docPath(collectionName, id) {
      return /databases/$(database)/documents/$(collectionName)/$(id);
    }

    function accessPath(houseId, userId) {
      return docPath('user_house_access', houseId + '_' + userId);
    }

    function isMember(houseId) {
      return signedIn() && exists(accessPath(houseId, uid()));
    }

    function isOwner(houseId) {
      return isMember(houseId) && get(accessPath(houseId, uid())).data.role == 'owner';
    }

    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // Once a field is encrypted, an older client cannot replace it with plaintext.
    // Plain legacy records remain readable until the coordinated migration.
    function keepsEncrypted(field) {
      let before = resource.data.get(field, null);
      let after = request.resource.data.get(field, null);
      return !(before is string && before.matches('enc:v1:.*'))
        || (after is string && after.matches('enc:v1:.*'));
    }

    function keepsSensitiveFieldsEncrypted(collectionName) {
      return (collectionName == 'caregivers'
          && keepsEncrypted('name') && keepsEncrypted('email')
          && keepsEncrypted('amount') && keepsEncrypted('dayAmount') && keepsEncrypted('nightAmount')
          && keepsEncrypted('additionalAmount')
          && (!(encryptedBefore('name') || encryptedBefore('email') || encryptedBefore('amount')
              || encryptedBefore('dayAmount') || encryptedBefore('nightAmount')
              || encryptedBefore('additionalAmount'))
            || createsEncryptedSensitiveFields(collectionName)))
        || (collectionName == 'paymentHistory'
          && keepsEncrypted('caregiverName') && keepsEncrypted('managerName')
          && keepsEncrypted('description') && keepsEncrypted('amount')
          && keepsEncrypted('dayRate') && keepsEncrypted('nightRate') && keepsEncrypted('additionalRate')
          && (!(encryptedBefore('caregiverName') || encryptedBefore('managerName')
              || encryptedBefore('description') || encryptedBefore('amount')
              || encryptedBefore('dayRate') || encryptedBefore('nightRate')
              || encryptedBefore('additionalRate'))
            || createsEncryptedSensitiveFields(collectionName)))
        || collectionName in ['schedule', 'payments'];
    }

    function encryptedBefore(field) {
      let value = resource.data.get(field, null);
      return value is string && value.matches('enc:v1:.*');
    }

    // New sensitive records must use the encrypted format. Otherwise an old
    // client could reintroduce plaintext by creating another document after migration.
    function encryptedOrAbsent(field) {
      let value = request.resource.data.get(field, null);
      return value == null || (value is string && value.matches('enc:v1:.*'));
    }

    function createsEncryptedSensitiveFields(collectionName) {
      return (collectionName == 'caregivers'
          && encryptedOrAbsent('name') && encryptedOrAbsent('email')
          && encryptedOrAbsent('amount') && encryptedOrAbsent('dayAmount') && encryptedOrAbsent('nightAmount')
          && encryptedOrAbsent('additionalAmount'))
        || (collectionName == 'paymentHistory'
          && encryptedOrAbsent('caregiverName') && encryptedOrAbsent('managerName')
          && encryptedOrAbsent('description') && encryptedOrAbsent('amount')
          && encryptedOrAbsent('dayRate') && encryptedOrAbsent('nightRate')
          && encryptedOrAbsent('additionalRate'))
        || collectionName in ['schedule', 'payments'];
    }

    // New sensitive documents start with at least one encrypted value. Otherwise
    // an empty create followed by a plaintext update could masquerade as legacy.
    function startsEncryptedRecord(collectionName) {
      let data = request.resource.data;
      return createsEncryptedSensitiveFields(collectionName)
        && ((collectionName == 'caregivers'
            && (data.get('name', null) != null || data.get('email', null) != null
              || data.get('amount', null) != null || data.get('dayAmount', null) != null
              || data.get('nightAmount', null) != null || data.get('additionalAmount', null) != null))
          || (collectionName == 'paymentHistory'
            && (data.get('caregiverName', null) != null || data.get('managerName', null) != null
              || data.get('description', null) != null || data.get('amount', null) != null
              || data.get('dayRate', null) != null || data.get('nightRate', null) != null
              || data.get('additionalRate', null) != null))
          || collectionName in ['schedule', 'payments']);
    }

    // Connection check done by the app on start
    match /_test/{docId} {
      allow get: if signedIn();
    }

    // Staff grants are provisioned with trusted administration, never profile fields.
    function isReportStaff() {
      return signedIn()
        && exists(docPath('staff_access', uid()))
        && get(docPath('staff_access', uid())).data.enabled == true;
    }

    function reportText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max
        && (min == 0 || value.matches('[\\s\\S]*[^\\s][\\s\\S]*'));
    }

    function nullableContextText(value) {
      return value == null || (value is string && value.size() <= 100);
    }

    function validReportContext(context) {
      return context is map
        && context.keys().hasAll(['appVersion', 'appBuild', 'platform', 'osVersion', 'language'])
        && context.keys().hasOnly(['appVersion', 'appBuild', 'platform', 'osVersion', 'language'])
        && nullableContextText(context.appVersion) && nullableContextText(context.appBuild)
        && reportText(context.platform, 1, 30) && reportText(context.osVersion, 0, 100)
        && reportText(context.language, 1, 30);
    }

    function validIssueUrl(value) {
      return value == null || (value is string && value.size() <= 500
        && value.matches('^https://github[.]com/[A-Za-z0-9_-]+/[A-Za-z0-9_.-]+/issues/[1-9][0-9]*$'));
    }

    function validNewReport(data) {
      let fields = ['schemaVersion', 'reporterUid', 'type', 'title', 'description',
        'steps', 'expected', 'actual', 'context', 'status', 'issueUrl', 'reviewerUid',
        'createdAt', 'updatedAt'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && data.schemaVersion == 1 && data.reporterUid == uid()
        && data.type in ['bug', 'feedback']
        && reportText(data.title, 3, 120) && reportText(data.description, 10, 5000)
        && reportText(data.steps, 0, 3000) && reportText(data.expected, 0, 2000)
        && reportText(data.actual, 0, 2000)
        && (data.type == 'bug' || (data.steps == '' && data.expected == '' && data.actual == ''))
        && validReportContext(data.context)
        && data.status == 'open' && data.issueUrl == null && data.reviewerUid == null
        && data.createdAt == request.time && data.updatedAt == request.time;
    }

    match /staff_access/{staffId} {
      allow get: if signedIn() && uid() == staffId;
      // All writes and list requests remain denied, including for approved staff.
    }

    match /feedback_reports/{reportId} {
      // An online transaction can check an unused random ID before creating it.
      allow get: if signedIn() && (!exists(docPath('feedback_reports', reportId))
        || isReportStaff() || resource.data.reporterUid == uid());
      allow list: if signedIn() && request.query.limit != null && request.query.limit <= 50
        && (isReportStaff() || resource.data.reporterUid == uid());
      allow create: if signedIn() && validNewReport(request.resource.data);
      allow update: if isReportStaff()
        && onlyChanges(['status', 'issueUrl', 'reviewerUid', 'updatedAt'])
        && request.resource.data.status in ['open', 'in_review', 'resolved']
        && validIssueUrl(request.resource.data.issueUrl)
        && request.resource.data.reviewerUid == uid()
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && (resource.data.reporterUid == uid() || isReportStaff());
    }

    match /users/{userId} {
      allow get, delete: if signedIn() && uid() == userId;
      allow create, update: if signedIn() && uid() == userId
        && request.resource.data.id == userId;
    }

    match /houses/{houseId} {
      allow get: if isMember(houseId);

      // Created in a batch together with the owner's access record and the house key
      allow create: if signedIn()
        && request.resource.data.id == houseId
        && request.resource.data.createdBy == uid()
        && getAfter(accessPath(houseId, uid())).data.role == 'owner';

      allow update: if (isOwner(houseId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdBy == resource.data.createdBy)
        || (isMember(houseId) && onlyChanges(['name', 'description', 'updatedAt']))
        || joiningHouse(houseId)
        || leavingHouse(houseId);

      allow delete: if isOwner(houseId);

      match /shiftNotes/{noteId} {
        allow get: if canUseShiftNotes(houseId) && !exists(/databases/$(database)/documents/houses/$(houseId)/shiftNotes/$(noteId));
        allow read: if signedIn() && ((resource.data.kind == 'message' && isMember(houseId))
          || resource.data.authorUid == uid() || activeNotesCaregiver(houseId));
        allow create: if signedIn() && exists(docPath('houses', houseId))
          && (request.resource.data.kind == 'handover' || canUseShiftNotes(houseId))
          && validShiftNote(houseId, request.resource.data)
          && request.resource.data.authorUid == uid()
          && request.resource.data.updatedBy == uid()
          && request.resource.data.revision == 1
          && request.resource.data.pendingStatus.values().hasOnly(['open'])
          && request.resource.data.resolvedFrom == null
          && request.resource.data.resolvedByCaregiverId == null
          && request.resource.data.createdAt == request.time
          && canWriteShiftNote(houseId, request.resource.data);
        allow update: if signedIn() && exists(docPath('houses', houseId))
          && (request.resource.data.kind == 'handover' || canUseShiftNotes(houseId))
          && validShiftNote(houseId, request.resource.data)
          && request.resource.data.revision == resource.data.revision + 1
          && request.resource.data.updatedBy == uid()
          && ((resource.data.authorUid == uid()
              && onlyChanges(['payload', 'pendingStatus', 'revision', 'updatedAt', 'updatedBy'])
              && request.resource.data.pendingStatus.diff(resource.data.pendingStatus).changedKeys().size() == 0
              && canWriteShiftNote(houseId, request.resource.data))
            || resolvingHandover(houseId));
        allow delete: if signedIn() && (resource.data.authorUid == uid()
          || (resource.data.kind == 'message' && isMember(houseId)));
      }

      // Caregivers, schedule, payments and payment history
      match /{collectionName}/{docId} {
        allow read, delete: if isMember(houseId)
          && collectionName in ['caregivers', 'schedule', 'payments', 'paymentHistory'];
        allow create: if isMember(houseId) && startsEncryptedRecord(collectionName);
        allow update: if isMember(houseId) && keepsSensitiveFieldsEncrypted(collectionName);
        // A caregiver who accepted working at the house follows its schedule
        allow read: if collectionName == 'schedule' && isAcceptedCaregiver(houseId);
      }
    }

    // A user accepting an invitation adds only themselves to the managers list, as a
    // manager, with the invited email and the inviter recorded by the invitation
    function joiningHouse(houseId) {
      let added = request.resource.data.managers.removeAll(resource.data.managers);
      let access = getAfter(accessPath(houseId, uid())).data;
      return signedIn()
        && !exists(accessPath(houseId, uid()))
        && existsAfter(accessPath(houseId, uid()))
        && onlyChanges(['managers', 'updatedAt'])
        && request.resource.data.managers.size() == resource.data.managers.size() + 1
        && request.resource.data.managers.hasAll(resource.data.managers)
        && added.size() == 1
        && added[0].keys().hasOnly(['userId', 'email', 'displayName', 'role', 'addedAt', 'addedBy'])
        && added[0].keys().hasAll(['userId', 'email', 'displayName', 'role', 'addedAt', 'addedBy'])
        && added[0].displayName is string
        && added[0].displayName.size() <= 200
        && added[0].addedAt is string
        && added[0].addedAt.size() == 24
        && added[0].userId == uid()
        && added[0].role == 'manager'
        && access.role == 'manager'
        && isVerifiedEmail(added[0].email)
        && added[0].addedBy == get(docPath('house_invitations', access.invitationId)).data.invitedBy;
    }

    // A manager leaving (account deletion) removes exactly their own entry, together
    // with their access record
    function leavingHouse(houseId) {
      let removed = resource.data.managers.removeAll(request.resource.data.managers);
      return isMember(houseId)
        && !existsAfter(accessPath(houseId, uid()))
        && onlyChanges(['managers', 'updatedAt'])
        && request.resource.data.managers.size() == resource.data.managers.size() - 1
        && resource.data.managers.hasAll(request.resource.data.managers)
        && removed.size() == 1
        && removed[0].userId == uid();
    }

    // Per-house encryption key: readable by members only, never replaced
    match /house_keys/{houseId} {
      allow get: if isMember(houseId);
      allow create: if signedIn()
        && existsAfter(accessPath(houseId, uid()))
        && request.resource.data.keys().hasOnly(['key', 'version', 'createdAt', 'createdBy'])
        && request.resource.data.key is string
        && request.resource.data.key.size() == 44
        && request.resource.data.createdBy == uid();
      allow update: if false;
      allow delete: if isOwner(houseId);
    }

    match /user_house_access/{accessId} {
      allow get, list: if signedIn()
        && (resource.data.userId == uid() || isOwner(resource.data.houseId));

      allow create: if signedIn()
        && request.resource.data.userId == uid()
        && accessId == request.resource.data.houseId + '_' + uid()
        && request.resource.data.role in ['owner', 'manager']
        && (creatingOwnHouse() || acceptingInvitation() || migratingLegacyAccess());

      allow update: if false;

      allow delete: if signedIn()
        && (resource.data.userId == uid() || isOwner(resource.data.houseId));
    }

    function creatingOwnHouse() {
      let housePath = docPath('houses', request.resource.data.houseId);
      return request.resource.data.role == 'owner'
        && !exists(housePath)
        && getAfter(housePath).data.createdBy == uid();
    }

    // The invitation must go from pending to accepted in the same batch, so an
    // invitation can't be reused after the user leaves or is removed
    function acceptingInvitation() {
      let invitationPath = docPath('house_invitations', request.resource.data.invitationId);
      let before = get(invitationPath).data;
      let after = getAfter(invitationPath).data;
      return request.resource.data.role == 'manager'
        && before.status == 'pending'
        && before.expiresAtTs > request.time
        && after.status == 'accepted'
        && after.houseId == request.resource.data.houseId
        && isVerifiedEmail(after.invitedEmail);
    }

    // Access records from before these rules had random ids
    function migratingLegacyAccess() {
      let legacy = get(docPath('user_house_access', request.resource.data.legacyAccessId)).data;
      return legacy.userId == uid()
        && legacy.houseId == request.resource.data.houseId
        && legacy.role == request.resource.data.role
        && (legacy.role == 'manager'
          || get(docPath('houses', legacy.houseId)).data.createdBy == uid());
    }

    // Link between a house caregiver record and her login email. Only the house's
    // managers and the caregiver herself read it: it holds her name, email and shifts.
    // Only she can accept it; managers can (re)invite, which resets it to pending.
    match /caregiver_links/{linkId} {
      // Link ids are "{houseId}__{caregiverId}", so managers can also check that a
      // link doesn't exist yet
      allow get: if isMember(linkId.split('__')[0])
        || isVerifiedEmail(resource.data.email);
      allow list: if isMember(resource.data.houseId)
        || isVerifiedEmail(resource.data.email);

      allow create: if isMember(request.resource.data.houseId)
        && linkId.matches(request.resource.data.houseId + '__.+')
        && request.resource.data.get('status', 'pending') == 'pending'
        && encryptedOrAbsent('pay');

      // Her pay is only ever stored encrypted with the link key (see below)
      allow update: if (isMember(resource.data.houseId)
          && request.resource.data.houseId == resource.data.houseId
          && managerKeepsAnswer()
          && encryptedOrAbsent('pay'))
        || (isVerifiedEmail(resource.data.email)
          && onlyChanges(['status', 'respondedAt'])
          && request.resource.data.status in ['accepted', 'declined']);

      allow delete: if isMember(resource.data.houseId);
    }

    // Key of the pay stored in a link. The caregiver reads it only once she accepted,
    // so she never gets the house key nor anyone else's pay.
    match /caregiver_link_keys/{linkId} {
      allow get: if isMember(linkId.split('__')[0])
        || acceptedLink(get(docPath('caregiver_links', linkId)).data, linkId.split('__')[0]);
      allow create: if isMember(linkId.split('__')[0])
        && request.resource.data.keys().hasOnly(['key', 'createdAt', 'createdBy'])
        && request.resource.data.key is string
        && request.resource.data.key.size() == 44
        && request.resource.data.createdBy == uid();
      allow update: if false;
      allow delete: if isMember(linkId.split('__')[0]);
    }

    // A manager keeps the caregiver's answer or resets it to pending; a new email
    // is always a new, pending invitation
    function managerKeepsAnswer() {
      let before = resource.data.get('status', 'pending');
      let after = request.resource.data.get('status', 'pending');
      return after == 'pending'
        || (after == before && request.resource.data.email == resource.data.email);
    }

    function acceptedLink(link, houseId) {
      return link.houseId == houseId
        && isVerifiedEmail(link.email)
        && link.status == 'accepted';
    }

    // The caregiver's access record points to the link that grants it, so removing
    // her email or a new invitation revokes her access immediately
    function isAcceptedCaregiver(houseId) {
      let accessDoc = docPath('caregiver_access', houseId + '_' + uid());
      return signedIn()
        && exists(accessDoc)
        && acceptedLink(get(docPath('caregiver_links', get(accessDoc).data.linkId)).data, houseId);
    }

    function activeNotesCaregiver(houseId) {
      let access = get(docPath('caregiver_access', houseId + '_' + uid())).data;
      let link = get(docPath('caregiver_links', access.linkId)).data;
      return acceptedLink(link, houseId) && link.get('disabled', false) == false;
    }

    function canUseShiftNotes(houseId) {
      return signedIn() && exists(docPath('houses', houseId))
        && (isMember(houseId) || activeNotesCaregiver(houseId));
    }

    function validShiftNote(houseId, data) {
      let fields = ['authorUid', 'caregiverId', 'kind', 'shiftKey', 'scheduleRef', 'payload', 'pendingStatus', 'resolvedFrom', 'resolvedByCaregiverId', 'revision', 'generation', 'createdAt', 'updatedAt', 'updatedBy'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && data.authorUid is string && data.authorUid.size() > 0 && data.authorUid.size() <= 128
        && data.kind in ['handover', 'message']
        && data.shiftKey is string && data.shiftKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}:(day|night)$')
        && data.scheduleRef == /databases/$(database)/documents/houses/$(houseId)/schedule/$(data.shiftKey.split(':')[0])
        && data.payload is string && data.payload.matches('enc:v1:.+') && data.payload.size() <= 40000
        && data.pendingStatus is map && data.pendingStatus.size() <= 20
        && data.pendingStatus.values().hasOnly(['open', 'done'])
        && ((data.kind == 'message' && data.caregiverId == null && data.pendingStatus.size() == 0)
          || (data.kind == 'handover' && data.caregiverId is string))
        && data.revision is int && data.revision > 0
        && data.generation is string && data.generation.size() > 0 && data.generation.size() <= 80
        && (data.resolvedByCaregiverId == null || data.resolvedByCaregiverId is string)
        && data.createdAt is timestamp && data.updatedAt == request.time;
    }

    function activeCaregiverId(houseId, caregiverId) {
      let link = get(docPath('caregiver_links', houseId + '__' + caregiverId)).data;
      return acceptedLink(link, houseId) && link.caregiverId == caregiverId
        && link.get('disabled', false) == false;
    }

    function canWriteShiftNote(houseId, data) {
      let parts = data.shiftKey.split(':');
      let day = get(/databases/$(database)/documents/houses/$(houseId)/schedule/$(parts[0])).data;
      let assigned = day.get(parts[1], []).concat(day.get(parts[1] + 'Extra', []));
      return assigned.size() > 0 && (data.kind == 'message'
        || (activeCaregiverId(houseId, data.caregiverId) && data.caregiverId in assigned));
    }

    function resolvingHandover(houseId) {
      let after = request.resource.data;
      let parts = after.resolvedFrom.split(':');
      let day = get(/databases/$(database)/documents/houses/$(houseId)/schedule/$(parts[0])).data;
      let caregiverId = after.resolvedByCaregiverId;
      return resource.data.kind == 'handover' && activeCaregiverId(houseId, caregiverId)
        && onlyChanges(['pendingStatus', 'resolvedFrom', 'resolvedByCaregiverId', 'revision', 'updatedAt', 'updatedBy'])
        && after.pendingStatus.keys().hasOnly(resource.data.pendingStatus.keys())
        && after.pendingStatus.keys().hasAll(resource.data.pendingStatus.keys())
        && after.resolvedFrom.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}:(day|night)$')
        && after.resolvedFrom > resource.data.shiftKey
        && caregiverId in day.get(parts[1], []).concat(day.get(parts[1] + 'Extra', []));
    }

    // Personal-data export and erasure remain possible after a house revokes access.
    // This grants only the author's records, never another caregiver's handover/key.
    match /{path=**}/shiftNotes/{noteId} {
      allow read: if signedIn() && resource.data.authorUid == uid();
      allow delete: if signedIn() && resource.data.authorUid == uid();
    }

    // Clinical keys are never readable by family-only accounts.
    match /shift_handover_keys/{houseId} {
      allow get: if signedIn() && activeNotesCaregiver(houseId);
      allow create: if signedIn() && activeNotesCaregiver(houseId)
        && request.resource.data.keys().hasOnly(['key', 'createdBy'])
        && request.resource.data.key is string
        && request.resource.data.key.matches('^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=$')
        && request.resource.data.createdBy == uid();
      allow delete: if isOwner(houseId) && !existsAfter(docPath('houses', houseId));
    }

    // Separate communication key: caregivers never receive the financial house key.
    match /shift_note_keys/{houseId} {
      allow get: if canUseShiftNotes(houseId);
      allow create: if canUseShiftNotes(houseId)
        && request.resource.data.keys().hasOnly(['key', 'createdBy'])
        && request.resource.data.key is string
        && request.resource.data.key.matches('^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=$')
        && request.resource.data.createdBy == uid();
      allow delete: if isOwner(houseId) && !existsAfter(docPath('houses', houseId));
    }

    match /caregiver_access/{accessId} {
      allow get, list, delete: if signedIn() && resource.data.userId == uid();
      allow create, update: if signedIn()
        && request.resource.data.userId == uid()
        && accessId == request.resource.data.houseId + '_' + uid()
        && acceptedLink(
          getAfter(docPath('caregiver_links', request.resource.data.linkId)).data,
          request.resource.data.houseId);
    }

    match /house_invitations/{invitationId} {
      allow get, list: if signedIn()
        && (isVerifiedEmail(resource.data.invitedEmail)
          || resource.data.invitedBy == uid()
          || isMember(resource.data.houseId));

      allow create: if signedIn()
        && request.resource.data.id == invitationId
        && request.resource.data.invitedBy == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.invitedEmail == request.resource.data.invitedEmail.lower()
        && request.resource.data.expiresAtTs is timestamp
        && request.resource.data.expiresAtTs <= request.time + duration.value(8, 'd')
        && isOwner(request.resource.data.houseId);

      allow update: if isVerifiedEmail(resource.data.invitedEmail)
        && resource.data.status == 'pending'
        && onlyChanges(['status'])
        && request.resource.data.status in ['accepted', 'declined'];

      allow delete: if signedIn()
        && (isVerifiedEmail(resource.data.invitedEmail)
          || resource.data.invitedBy == uid()
          || isOwner(resource.data.houseId));
    }
  }
}
