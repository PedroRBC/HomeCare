# Create a dedicated Firebase web app for the HomeCare report reviewer.
# These browser values are public configuration, never service-account credentials.
VITE_FIREBASE_API_KEY=replace-with-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=1:123456789:web:replace-with-web-app-id

# Set true only for local development with `bun run emulators:local`.
# The reviewer refuses emulator mode on non-localhost origins.
VITE_USE_EMULATORS=false
