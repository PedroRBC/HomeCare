{
  "react-native": {
    "android_bypass_emulator_url_remap": true,
    "analytics_auto_collection_enabled": false,
    "analytics_default_allow_analytics_storage": false,
    "analytics_default_allow_ad_storage": false,
    "analytics_default_allow_ad_user_data": false,
    "analytics_default_allow_ad_personalization_signals": false,
    "google_analytics_adid_collection_enabled": false,
    "crashlytics_auto_collection_enabled": false
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "shift-notes",
      "ignore": ["node_modules", "*.test.js", "bun.lock"]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": { "host": "127.0.0.1", "port": 9199 },
    "firestore": { "host": "127.0.0.1", "port": 8180 },
    "hub": { "host": "127.0.0.1", "port": 4410 },
    "logging": { "host": "127.0.0.1", "port": 4600 },
    "ui": { "enabled": false },
    "singleProjectMode": false
  }
}
