# Firebase Google Auth Client IDs
# Obtenha estes valores seguindo as instruções em GOOGLE_AUTH_SHA1_INSTRUCTIONS.md

# Web Client ID (obrigatório) - encontrado no Google Cloud Console
GOOGLE_WEB_CLIENT_ID=SEU_WEB_CLIENT_ID.apps.googleusercontent.com

# iOS Client ID (opcional - está no GoogleService-Info.plist)
# GOOGLE_IOS_CLIENT_ID=SEU_IOS_CLIENT_ID.apps.googleusercontent.com

# Android Client ID (opcional - está no google-services.json)
# GOOGLE_ANDROID_CLIENT_ID=SEU_ANDROID_CLIENT_ID.apps.googleusercontent.com
