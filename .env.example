# Google Sign-In: veja "Login com Google no Android" em CONTRIBUTING.md.
# No Android, o Web client ID é extraído automaticamente do google-services.json
# selecionado (cliente OAuth de tipo 3 do package do app). Não é preciso definir IDs.

# Opcional: substitua apenas se precisar de outro Web OAuth client ID válido.
# GOOGLE_WEB_CLIENT_ID=123456789-clientid.apps.googleusercontent.com

# Opcional: arquivo Firebase Android alternativo (caminho relativo à raiz ou absoluto).
# GOOGLE_SERVICES_JSON=./google-services.json

# iOS Client ID (opcional - está no GoogleService-Info.plist).
# GOOGLE_IOS_CLIENT_ID=123456789-iosclientid.apps.googleusercontent.com

# O Android OAuth client ID não é passado ao SDK. O package e os certificados
# SHA-1/SHA-256 de cada assinatura devem estar cadastrados no Firebase/Google.
