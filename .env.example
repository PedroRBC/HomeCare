# Arquivo local: copie para .env, preencha os campos e nunca versione valores reais.
# GOOGLE_SERVICES_JSON é um CAMINHO local; no EAS é uma variável de arquivo Secret.
# O JSON real pode continuar na raiz da máquina, ignorado pelo Git.
GOOGLE_SERVICES_JSON=./google-services.json

# Referência confirmada no Firebase Console (mesmo projeto que preserva usuários/dados).
# Obrigatória no verificador de release; não use o projeto demo do CI.
# FIREBASE_EXPECTED_PROJECT_ID=your-existing-firebase-project

# Web OAuth client ID (tipo 3), não Android. Disponível à avaliação local EAS
# mesmo quando o arquivo Secret remoto não está disponível. Não é client secret.
# GOOGLE_WEB_CLIENT_ID=123456789-example.apps.googleusercontent.com
# GOOGLE_IOS_CLIENT_ID=123456789-ios-example.apps.googleusercontent.com

# Defina explicitamente true ou false no release, conforme os provedores existentes.
# Não desative Facebook se contas existentes dependem desse login.
# FACEBOOK_ENABLED=true
# FACEBOOK_APP_ID=123456789012345
# FACEBOOK_CLIENT_TOKEN=your-facebook-client-token
# O APP SECRET da Meta fica apenas no provedor Firebase, NUNCA no app ou neste arquivo.

# Upload key EXISTENTE aceita pela Play (não é a Play app signing key).
# Certificado SHA-256 esperado: confira independentemente em Play > App integrity.
# ANDROID_EXPECTED_UPLOAD_CERT_SHA256=
# ANDROID_KEYSTORE_PATH=./.secrets/upload-keystore.jks
# ANDROID_KEYSTORE_PASSWORD=
# ANDROID_KEY_ALIAS=upload
# ANDROID_KEY_PASSWORD=
# ANDROID_VERSION_CODE=
# No GitHub, use ANDROID_KEYSTORE_BASE64 em vez do caminho local.
# Sem assinatura configurada, previews locais usam a chave debug do template.

# Nunca inclua house_keys, tokens de usuários, service accounts ou senhas do banco.
# Consulte docs/credentials-and-release.md para o TODO e a matriz local/EAS/GitHub.
